ARCHITECTURE.md
DESIGN_GUIDE.md
tasks/

# ─── Dependencies ───
node_modules/
.pnp/
.pnp.js

# ─── Expo ───
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ─── Native (generated by `expo prebuild` — CNG, regenerated on demand) ───
# Anchored to the repo root: only the prebuild output is ignored, NOT the
# hand-written Kotlin/Swift sources of the local modules under modules/*.
/android/
/ios/
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.orig.*

# Local module build artifacts (sources under modules/*/android|ios/src stay tracked)
modules/*/android/build/
modules/*/ios/build/

# Gradle caches (regenerated by every build, never source)
.gradle/
modules/*/android/.gradle/
modules/*/ios/.gradle/

# ─── Metro / bundler ───
.metro-health-check*
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# ─── Testing & coverage ───
coverage/
.jest/
*.tsbuildinfo

# ─── Env & secrets ───
.env
.env.*
!.env.example

# ─── OS / editors ───
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── Misc ───
tmp/
temp/
